    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Replace each Formatter step with a line here: text case, dates, numbers, lookups.\nconst b = $json.body || $json;\nreturn { json: {\n  email: String(b.email || '').trim().toLowerCase(),\n  name: String(b.name || '').trim().replace(/\\b\\w/g, c => c.toUpperCase()),\n  amount: Number(String(b.amount || '0').replace(/[^0-9.-]/g, '')),\n  date: b.date ? new Date(b.date).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10),\n  raw: b,\n} };"
      },
