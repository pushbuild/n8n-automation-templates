        "method": "POST",
        "url": "={{ $('Config').first().json.qbo_base_url }}/v3/company/{{ $('Config').first().json.realm_id }}/invoice?minorversion=73",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.invoice) }}"
      },
      "id": "5325c6ab-78d4-521e-8a90-de21e0b1c595",
      "name": "Create invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
