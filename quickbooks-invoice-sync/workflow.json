        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `Invoice ${$json.Invoice.DocNumber} created in QuickBooks for ${$('Normalize job').item.json.customer_name}.` }) }}"
      },
      "id": "3aca4d7e-6d57-5fd9-b75d-5e06260182fe",
