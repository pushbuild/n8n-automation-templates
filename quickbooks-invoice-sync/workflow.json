   "id": "65d59413-6b53-557f-8654-62b360622511",
   "name": "Config",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "\n// Field names come from Config (field_*), so any system's payload works without editing code. Dotted paths are allowed.\nconst cfg = $('Config').first().json;\nconst get = (o, p) => String(p || '').split('.').reduce((v, k) => v == null ? v : v[k], o);\nreturn $input.all().map(i => {\n  const b = i.json.body || i.json;\n  const id = String(get(b, cfg.field_job_id) || '').trim();\n  let lines = get(b, cfg.field_lines);\n  if (!Array.isArray(lines) || !lines.length) lines = [{ [cfg.field_line_description]: get(b, cfg.field_description) || 'Services', [cfg.field_line_qty]: 1, [cfg.field_line_rate]: get(b, cfg.field_amount) }];\n  lines = lines.map(l => ({ description: String(get(l, cfg.field_line_description) || 'Services'), qty: Number(get(l, cfg.field_line_qty) || 1),\n    rate: Number(get(l, cfg.field_line_rate)), item_id: String(get(l, cfg.field_line_item_id) || cfg.default_item_id) }));\n  const doc = (cfg.invoice_prefix || '') + id, customer = String(get(b, cfg.field_customer) || '').trim();\n  const problems = [!id && 'no job id', doc.length > 21 && 'invoice number over 21 characters', !customer && 'no customer name',\n    lines.some(l => !isFinite(l.rate) || !isFinite(l.qty)) && 'a line has no valid quantity or rate'].filter(Boolean);\n  return { json: { ref: doc || '(no job id)', doc_number: doc, customer, email: String(get(b, cfg.field_email) || '').trim(), lines,\n    total: Math.round(lines.reduce((s, l) => s + l.qty * l.rate, 0) * 100) / 100, problem: problems.join(', ') } };\n});\n"
   },
