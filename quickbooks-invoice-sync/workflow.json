    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.qbo_base_url }}/v3/company/{{ $('Config').first().json.realm_id }}/customer?minorversion=73",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ DisplayName: $('Normalize job').item.json.customer_name, PrimaryEmailAddr: { Address: $('Normalize job').item.json.customer_email } }) }}"
      },
      "id": "19147db6-247b-562b-aab1-4c520270323c",
      "name": "Create customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        500
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('Normalize job').item.json;\nconst cfg = $('Config').first().json;\nconst id = ($json.QueryResponse && $json.QueryResponse.Customer) ? $json.QueryResponse.Customer[0].Id : $json.Customer.Id;\nconst invoice = {\n  DocNumber: job.job_id,\n  CustomerRef: { value: id },\n  BillEmail: job.customer_email ? { Address: job.customer_email } : undefined,\n  Line: job.lines.map(l => ({\n    DetailType: 'SalesItemLineDetail',\n    Amount: Math.round(Number(l.qty) * Number(l.rate) * 100) / 100,\n    Description: l.description,\n    SalesItemLineDetail: { ItemRef: { value: l.item_id || cfg.default_item_id }, Qty: Number(l.qty), UnitPrice: Number(l.rate) },\n  })),\n};\nreturn { json: { invoice } };"
      },
      "id": "1576d5ec-d4ff-501c-aa16-3d1f444f1679",
      "name": "Build invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        400
      ]
    },
    {
