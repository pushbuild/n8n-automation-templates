  {
   "parameters": {
    "jsCode": "\n// DocNumber is the job id (plus any prefix), which is how the duplicate check above finds it next time.\nconst job = $('Map job').item.json, cfg = $('Config').first().json;\nconst id = $json.Customer ? $json.Customer.Id : $json.QueryResponse.Customer[0].Id;\nconst due = new Date(Date.now() + Number(cfg.due_days || 30) * 864e5).toISOString().slice(0, 10);\nreturn { json: { ref: job.ref, invoice: {\n  DocNumber: job.doc_number, CustomerRef: { value: id }, DueDate: due,\n  BillEmail: job.email ? { Address: job.email } : undefined,\n  Line: job.lines.map(l => ({ DetailType: 'SalesItemLineDetail', Amount: Math.round(l.qty * l.rate * 100) / 100, Description: l.description,\n    SalesItemLineDetail: { ItemRef: { value: l.item_id }, Qty: l.qty, UnitPrice: l.rate } })) } } };\n",
    "mode": "runOnceForEachItem"
   },
