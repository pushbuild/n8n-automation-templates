      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Map your job, order or CRM fields here. One item per job.\nreturn $input.all().map(i => {\n  const b = i.json.body || i.json;\n  return { json: {\n    job_id: String(b.job_id || b.id || ''),\n    customer_name: (b.customer_name || b.customer || '').trim(),\n    customer_email: (b.customer_email || b.email || '').trim(),\n    lines: (b.lines || [{ description: b.description || 'Services', qty: 1, rate: Number(b.amount) || 0 }]),\n  } };\n});"
      },
      "id": "73f2a141-5463-5f6c-94d6-82850b9f80d2",
      "name": "Normalize job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.qbo_base_url }}/v3/company/{{ $('Config').first().json.realm_id }}/query",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "=select Id from Invoice where DocNumber = '{{ $json.job_id.replace(/'/g, \"\\\\'\") }}'"
            },
            {
              "name": "minorversion",
              "value": "73"
            }
          ]
        }
      },
      "id": "fd1a0bfa-9b59-5a4d-918e-c9b9464063d0",
      "name": "Find invoice by job number",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "17267a44-58eb-55c7-ac3a-bb6d1001389d",
              "leftValue": "={{ ($json.QueryResponse.Invoice || []).length }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f02a8cf3-2483-5647-aea0-ba3f0eae902a",
      "name": "Already invoiced?",
