        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `Skipped job ${$('Normalize job').item.json.job_id}: already invoiced in QuickBooks.` }) }}"
      },
