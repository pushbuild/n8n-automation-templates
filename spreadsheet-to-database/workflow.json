              "id": "5fdc545d-36d2-5fbf-814a-23c70b349acb",
              "leftValue": "={{ $json._valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fb4a524f-f314-595a-b6ab-2ec5ccef20f5",
