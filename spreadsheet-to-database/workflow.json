    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => `row ${i.json.sheet_row}: ${i.json.errors}`);\nreturn [{ json: { text: `${rows.length} sheet rows were not loaded:\\n` + rows.slice(0, 30).join('\\n') } }];"
      },
      "id": "3e36797a-fe7b-5775-a30c-ca3f77d60c0b",
      "name": "Summarize rejects",
