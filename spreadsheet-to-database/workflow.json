      "id": "2618359d-2a97-593e-bd69-a67ee143ff3b",
      "name": "Read sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One rule per line. Rows that fail go to the rejects report instead of the database.\nconst seen = new Set();\nreturn $input.all().map((i, n) => {\n  const r = i.json;\n  const row = {\n    external_id: String(r.id || r.ID || '').trim(),\n    name: String(r.name || r.Name || '').trim(),\n    email: String(r.email || r.Email || '').trim().toLowerCase(),\n    status: String(r.status || r.Status || 'active').trim().toLowerCase(),\n    amount: r.amount === '' || r.amount == null ? null : Number(String(r.amount).replace(/[^0-9.-]/g, '')),\n  };\n  const errors = [];\n  if (!row.external_id) errors.push('missing id');\n  if (seen.has(row.external_id)) errors.push('duplicate id');\n  if (row.email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(row.email)) errors.push('bad email');\n  if (row.amount !== null && Number.isNaN(row.amount)) errors.push('amount not a number');\n  if (!['active', 'paused', 'closed'].includes(row.status)) errors.push('unknown status');\n  seen.add(row.external_id);\n  return { json: errors.length ? { _valid: false, sheet_row: n + 2, errors: errors.join(', '), ...row } : { _valid: true, ...row } };\n});"
      },
      "id": "ef95dd13-f861-5847-b496-234890329db9",
      "name": "Validate and clean",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
