      "id": "58984ddc-bdef-51d9-b63a-dded77f7f24f",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Map your form's fields here. Works with most form tools that POST JSON.\nconst cfg = $('Config').first().json;\nreturn $input.all().map(i => {\n  const b = i.json.body || i.json;\n  const lead = {\n    name: (b.name || [b.first_name, b.last_name].filter(Boolean).join(' ') || '').trim(),\n    email: (b.email || '').trim().toLowerCase(),\n    phone: (b.phone || '').trim(),\n    company: (b.company || '').trim(),\n    message: (b.message || b.notes || '').trim(),\n    source: b.source || 'website form',\n  };\n  const request = {\n    model: cfg.openai_model,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: `You qualify inbound leads for ${cfg.business_name}. Reply with JSON: {\"score\": 1-10, \"reason\": \"one sentence\", \"summary\": \"one sentence\"}. 10 = ready to buy, clear need, good fit. 1 = spam or no fit.` },\n      { role: 'user', content: JSON.stringify(lead) },\n    ],\n  };\n  return { json: { ...lead, request } };\n});"
      },
      "id": "4101fe72-a581-5326-b109-be31d5a74cb7",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}"
      },
      "id": "3dfe838b-a81c-5c6a-8a0c-fad540f52a5c",
      "name": "Score lead (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Normalize lead').item.json;\nlet s = { score: 0, reason: 'could not score', summary: '' };\ntry { s = JSON.parse($json.choices[0].message.content); } catch (e) {}\nconst { request, ...rest } = lead;\nreturn { json: { ...rest, score: Number(s.score) || 0, reason: s.reason, summary: s.summary } };"
      },
      "id": "cc6ebe98-2bf2-5dd3-8412-1321073edab9",
      "name": "Read score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.from_email }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=Thanks, {{ $json.name.split(' ')[0] || 'there' }}. We got your message",
        "emailFormat": "text",
        "text": "=Hi {{ $json.name.split(' ')[0] || 'there' }},\n\nThanks for getting in touch with {{ $('Config').first().json.business_name }}. We will reply within one business day. If it is easier, you can pick a time to talk here: {{ $('Config').first().json.booking_link }}\n\n{{ $('Config').first().json.business_name }}",
        "options": {}
      },
      "id": "3d34b3b4-a707-57d6-92e5-1f267f8abc3c",
      "name": "Reply to lead",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: [{ idProperty: 'email', id: $('Read score').item.json.email, properties: { email: $('Read score').item.json.email, firstname: $('Read score').item.json.name.split(' ')[0], lastname: $('Read score').item.json.name.split(' ').slice(1).join(' '), phone: $('Read score').item.json.phone, company: $('Read score').item.json.company, hs_lead_status: 'NEW' } }] }) }}"
      },
      "id": "95d2bfb5-ae94-54e8-a817-411fe88e9f05",
      "name": "Upsert contact (HubSpot)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
